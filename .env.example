# Supabase — from your project's API settings (or `pnpm supabase start` for local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is reachable. Used to build the Screen / OBS links an operator
# copies to another machine, and the OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where a new song's web search looks: the catalogue that suggests artist and
# title, and the service that has the words. Both are free and key-less, and
# both are proxied server-side so the console never talks to them directly.
DEEZER_API_URL=https://api.deezer.com
LYRICS_API_URL=https://api.lyrics.ovh

# Dodo Payments. The API key and the webhook key are per-environment: a
# test_mode key will not open a live_mode checkout, and swapping one without
# the other is the usual cause of "bad signature" in the webhook log.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# The Pro subscription product, created in the Dodo dashboard at $9/month.
DODO_PAYMENTS_PRODUCT_PRO=
# test_mode until you are ready to charge anyone. Anything else is treated as
# test_mode, so a missing value cannot bill a church by accident.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Flip to 1 to start enforcing plan limits in the console. The database has its
# own switch and the two are meant to move together:
#   update public.billing_config set enforce = true;
NEXT_PUBLIC_ENFORCE_GATES=0
