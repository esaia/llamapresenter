# Supabase — from your project's API settings (or `pnpm supabase start` for local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is reachable. Used to build the Screen / OBS links an operator
# copies to another machine, and the OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where a new song's web search looks: the catalogue that suggests artist and
# title, and the service that has the words. Both are free and key-less, and
# both are proxied server-side so the console never talks to them directly.
DEEZER_API_URL=https://api.deezer.com
LYRICS_API_URL=https://api.lyrics.ovh

# Dodo Payments. The API key and the webhook key are per-environment: a
# test_mode key will not open a live_mode checkout, and swapping one without
# the other is the usual cause of "bad signature" in the webhook log.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# One subscription product per rung of the founding ladder, created in the Dodo
# dashboard at $9, $14 and $19 a month. Three products rather than one product
# and a coupon: a subscription is bound to the product it was created on, so the
# processor is what holds a church's rate for as long as it stays subscribed.
DODO_PAYMENTS_PRODUCT_PRO_FOUNDING=
DODO_PAYMENTS_PRODUCT_PRO_EARLY=
DODO_PAYMENTS_PRODUCT_PRO_STANDARD=
# The same three rungs sold by the year, at $89, $139 and $189, billing period
# 1 year. Their own products for the same reason: the cadence, like the rate, is
# the processor's to hold. Leave them empty and the yearly button 503s rather
# than quietly selling a month.
DODO_PAYMENTS_PRODUCT_PRO_FOUNDING_ANNUAL=
DODO_PAYMENTS_PRODUCT_PRO_EARLY_ANNUAL=
DODO_PAYMENTS_PRODUCT_PRO_STANDARD_ANNUAL=
# The old single-product variables. Still read as the standard rung, so an
# install that predates the ladder keeps working with the id it already has.
DODO_PAYMENTS_PRODUCT_PRO=
DODO_PAYMENTS_PRODUCT_PRO_ANNUAL=
# test_mode until you are ready to charge anyone. Anything else is treated as
# test_mode, so a missing value cannot bill a church by accident.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Flip to 1 to start enforcing plan limits in the console. The database has its
# own switch and the two are meant to move together:
#   update public.billing_config set enforce = true;
NEXT_PUBLIC_ENFORCE_GATES=0

# Cloudflare Turnstile's site key, from the Turnstile dashboard — public, so it
# is safe in the client bundle. Guards the "try for free" button's anonymous
# sign-in against being farmed for throwaway rooms; the matching secret key is
# pasted into Supabase's own dashboard (Authentication → Attack Protection),
# never here. Leave empty and the button signs in without a captcha, which is
# what local dev does.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
